{
  "name": "stacks-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "test": "jest --watchAll",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:staging": "cross-env APP_ENV=staging expo run:android",
    "android:development": "cross-env APP_ENV=development expo run:android",
    "android:production": "cross-env APP_ENV=production expo run:android",
    "ios": "expo run:ios",
    "ios:production": "cross-env APP_ENV=production expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "prebuild": "expo prebuild",
    "prebuild:development": "cross-env APP_ENV=development pnpm run prebuild",
    "prebuild:staging": "cross-env APP_ENV=staging pnpm run prebuild",
    "prebuild:production": "cross-env APP_ENV=production pnpm run prebuild",
    "build:development:android": "cross-env APP_ENV=development eas build --profile development --platform android",
    "build:development:ios": "cross-env APP_ENV=development eas build --profile development --platform ios",
    "build:staging:android": "cross-env APP_ENV=staging eas build --profile staging --platform android",
    "build:staging:ios": "cross-env APP_ENV=staging eas build --profile staging --platform ios",
    "build:production:android": "cross-env APP_ENV=production eas build --profile production --platform android",
    "build:production:ios": "cross-env APP_ENV=production eas build --profile production --platform ios"
  },
  "dependencies": {
    "@degenlab/stacks-wallet-kit-core": "2.0.0",
    "@degenlab/stacks-wallet-kit-mobile": "2.0.0",
    "@dev-plugins/react-query": "^0.4.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.2.12",
    "@stacks/network": "^7.2.0",
    "@stacks/transactions": "^7.3.0",
    "@tanstack/react-query": "^5.90.12",
    "@transak/ui-expo-sdk": "^1.1.0",
    "axios": "^1.13.2",
    "buffer": "^6.0.3",
    "expo": "~54.0.26",
    "expo-apple-authentication": "~8.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.9",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "^17.0.8",
    "expo-router": "~6.0.16",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-tracking-transparency": "~6.0.8",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.9",
    "lucide-react-native": "^0.556.0",
    "moti": "^0.30.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.68.0",
    "react-native": "0.81.5",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-google-mobile-ads": "^16.0.1",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-query-kit": "^3.3.2",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "victory-native": "^41.20.2",
    "zustand": "^5.0.9",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eas-cli": "^18.5.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.16",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2",
    "zod": "^4.1.13"
  },
  "private": true,
  "pnpm": {},
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.cjs"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.*/)?((jest-)?react-native|@react-native(-community)?|@react-native-firebase/.*|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|moti|@degenlab/.*|@noble/.*|@scure/.*|@stacks/.*|@dev-plugins/.*|micro-packed))"
    ]
  }
}
