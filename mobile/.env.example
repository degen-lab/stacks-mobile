# Optional (defaults to development)
APP_ENV=development

# Optional (mainnet | testnet)
NETWORK=testnet

# Build-time (required)
EAS_PROJECT_ID=your-eas-project-id-here

# Google Sign-In (required)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id-here
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id-here
GOOGLE_IOS_URL_SCHEME=your-google-ios-url-scheme-here

# Backend (required)
API_URL=https://your-api-url.com

# AdMob
ANDROID_ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ANDROID_REWARDS_AD_MOBIN_KEY=your-android-admob-key-here
IOS_ADMOB_APP_ID=your-ios-admob-app-id-here

# Transak (required)
TRANSAK_STAGING_API_KEY=your-transak-staging-api-key-here

# sBTC bridge
SBTC_BRIDGE_MAINNET_EMILY_URL=https://emily.api.stacks.engineering
SBTC_BRIDGE_TESTNET_EMILY_URL=https://emily.api.test.stacks.engineering
SBTC_BRIDGE_MAINNET_CONTRACT_DEPLOYER=SM3VDXK3WZZSA84XXFKAFAF15NNZX32CTSG82JFQ4
SBTC_BRIDGE_TESTNET_CONTRACT_DEPLOYER=ST1F7QA2MDF17S807EPA36TSS8AMEFY4KA9TVGWXT

